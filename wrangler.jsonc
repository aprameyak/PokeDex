{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokedex",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokedex-db",
      "database_id": "f52a12c4-6256-4833-8be4-668545bdcf52"
    }
  ]
}
